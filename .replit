modules = ["nodejs-20"]
language = "javascript"
onBoot = "npm install"
build = "npm install && npm run build"

[run]
args = ["npm", "start"]

[run.env]
PORT = "8080"
DATA_DIR = "./data"
TRUST_PROXY = "true"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
build = "npm install && npm run build"
run = "TRUST_PROXY=true exec npm start"

[[ports]]
localPort = 8080
externalPort = 80
