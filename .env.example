# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public identity (path-based routing: https://DOMAIN/<username>[/2|/3])
PUBLIC_DOMAIN=tunnel.example.com
PUBLIC_BASE_URL=https://tunnel.example.com
TRUST_PROXY=false

# Sessions & tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-32-plus-random-chars-minimum

# Database (embedded JSON store; no external DB needed in single-server mode)
DATA_DIR=./data
DATA_FILE=tmin.json

# Admin bootstrap (first start only; never overwritten on restart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Anonymous tunnels
ANONYMOUS_TUNNEL_TTL_SECONDS=1800
ANONYMOUS_MAX_PER_IP=10
ANONYMOUS_ABUSE_BLOCK_SECONDS=600
ANONYMOUS_MAX_BODY_BYTES=1048576

# Free plan (usage period is fixed to UTC day in this version)
FREE_MAX_CONCURRENT_TUNNELS=3
FREE_UPLOAD_LIMIT_BYTES=1073741824
FREE_DOWNLOAD_LIMIT_BYTES=1073741824
USAGE_WARN_PERCENT=80

# Protocol / gateway limits
REQUEST_TIMEOUT_MS=30000
MAX_CONCURRENT_PER_TUNNEL=50
MAX_BODY_BYTES=10485760
WS_MAX_FRAME_BYTES=1048576
WS_MAX_LIFETIME_SECONDS=3600
HEARTBEAT_INTERVAL_MS=25000
HEARTBEAT_TIMEOUT_MS=60000
SHUTDOWN_DRAIN_MS=10000

# Rate limits
RATE_AUTH_PER_MIN=20
RATE_API_PER_MIN=300
RATE_PUBLIC_PER_MIN=600

# Retention
REQUEST_LOG_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
ANON_CLEANUP_INTERVAL_MS=60000

# Maintenance
MAINTENANCE_MODE=false
